# YOUR GATI — Environment Variables Configuration

# 1. Google Gemini API Key (Required for Real Gemini Vision AI Multimodal Analysis)
# Obtain your key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Backend Credentials (Optional - App uses high-fidelity mock fallback if unconfigured)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
